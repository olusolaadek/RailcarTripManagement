@page "/railcar-trips-v2"
@using RailcarTripManagement.Shared.Models
@using RailcarTripManagement.Client.Services
@inject IRailcarTripService TripService

@* 
    Alternative implementation using service abstraction
    To use this version:
    1. Register IRailcarTripService in Program.cs
    2. Update NavMenu to point to /railcar-trips-v2
    Or rename this file to RailcarTrips.razor
*@

<PageTitle>Railcar Trips</PageTitle>

<h1>Railcar Trips Management</h1>

<div class="card mb-4">
    <div class="card-header">
        <h3>Upload Equipment Events</h3>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label for="fileInput" class="form-label">Select CSV File (equipment_events.csv)</label>
            <InputFile id="fileInput" 
                       OnChange="@HandleFileSelection" 
                       class="form-control" 
                       accept=".csv"
                       disabled="@isUploading" />
            <div class="form-text">Upload a CSV file containing equipment events</div>
        </div>

        @if (selectedFile != null)
        {
            <div class="alert alert-info">
                <strong>Selected File:</strong> @selectedFile.Name (@FormatFileSize(selectedFile.Size))
            </div>
        }

        <button class="btn btn-primary" 
                @onclick="ProcessFile" 
                disabled="@(selectedFile == null || isUploading)">
            @if (isUploading)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Processing...</span>
            }
            else
            {
                <span>Process Events</span>
            }
        </button>

        @if (importResult != null)
        {
            <div class="mt-3">
                @if (importResult.Success)
                {
                    <div class="alert alert-success">
                        <h5>? Import Successful</h5>
                        <ul class="mb-0">
                            <li>Events Parsed: <strong>@importResult.EventsParsed</strong></li>
                            <li>Trips Created: <strong>@importResult.TripsCreated</strong></li>
                            <li>Incomplete Trips: <strong>@importResult.IncompleteTrips</strong></li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        <h5>? Import Failed</h5>
                        @foreach (var error in importResult.Errors)
                        {
                            <p>@error</p>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Trips</h3>
        <button class="btn btn-sm btn-outline-primary" @onclick="LoadTrips">Refresh</button>
    </div>
    <div class="card-body">
        @if (isLoadingTrips)
        {
            <div class="text-center py-5">
                <div class="spinner-border"></div>
                <p>Loading trips...</p>
            </div>
        }
        else if (!trips.Any())
        {
            <div class="alert alert-info">No trips found.</div>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Equipment ID</th>
                        <th>Origin</th>
                        <th>Destination</th>
                        <th>Start (UTC)</th>
                        <th>End (UTC)</th>
                        <th>Total Hours</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trip in trips)
                    {
                        <tr>
                            <td>@trip.EquipmentId</td>
                            <td>@trip.OriginCity</td>
                            <td>@trip.DestinationCity</td>
                            <td>@trip.StartUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@trip.EndUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@trip.TotalTripHours.ToString("F2")</td>
                            <td>
                                <button class="btn btn-sm btn-info" @onclick="() => ViewTripEvents(trip)">
                                    View Events
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private IBrowserFile? selectedFile;
    private List<TripDto> trips = new();
    private TripDto? selectedTrip;
    private ImportResultDto? importResult;
    
    private bool isUploading = false;
    private bool isLoadingTrips = false;

    private const long MaxFileSize = 10 * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        await LoadTrips();
    }

    private void HandleFileSelection(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        importResult = null;
    }

    private async Task ProcessFile()
    {
        if (selectedFile == null) return;

        isUploading = true;
        try
        {
            using var stream = selectedFile.OpenReadStream(MaxFileSize);
            importResult = await TripService.ImportEventsAsync(stream, selectedFile.Name);
            
            if (importResult.Success)
            {
                await LoadTrips();
                selectedFile = null;
            }
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task LoadTrips()
    {
        isLoadingTrips = true;
        try
        {
            trips = await TripService.GetTripsAsync();
        }
        finally
        {
            isLoadingTrips = false;
        }
    }

    private async Task ViewTripEvents(TripDto trip)
    {
        selectedTrip = trip;
        var events = await TripService.GetTripEventsAsync(trip.TripId);
        // TODO: Show events in modal (implementation similar to main version)
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
