@page "/railcar-trips"
@using RailcarTripManagement.Shared.Models
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Railcar Trips</PageTitle>

<h1>Railcar Trips Management</h1>

<div class="card mb-4">
    <div class="card-header">
        <h3>Upload Equipment Events</h3>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label for="fileInput" class="form-label">Select CSV File (equipment_events.csv)</label>
            <InputFile id="fileInput" 
                       OnChange="@HandleFileSelection" 
                       class="form-control" 
                       accept=".csv"
                       disabled="@isUploading" />
            <div class="form-text">Upload a CSV file containing equipment events (Equipment Id, Event Code, Event Time, City Id)</div>
        </div>

        @if (selectedFile != null)
        {
            <div class="alert alert-info">
                <strong>Selected File:</strong> @selectedFile.Name (@FormatFileSize(selectedFile.Size))
            </div>
        }

        <button class="btn btn-primary" 
                @onclick="ProcessFile" 
                disabled="@(selectedFile == null || isUploading)">
            @if (isUploading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Processing...</span>
            }
            else
            {
                <span>Process Events</span>
            }
        </button>

        @if (importResult != null)
        {
            <div class="mt-3">
                @if (importResult.Success)
                {
                    <div class="alert alert-success">
                        <h5>✓ Import Successful</h5>
                        <ul class="mb-0">
                            <li>Events Parsed: <strong>@importResult.EventsParsed</strong></li>
                            <li>Trips Created: <strong>@importResult.TripsCreated</strong></li>
                            <li>Incomplete Trips: <strong>@importResult.IncompleteTrips</strong></li>
                            @if (importResult.WarningsCount > 0)
                            {
                                <li>Warnings: <strong>@importResult.WarningsCount</strong></li>
                            }
                        </ul>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        <h5>✗ Import Failed</h5>
                        <p class="mb-0">Errors: @importResult.ErrorsCount</p>
                    </div>
                }

                @if (importResult.Warnings.Any())
                {
                    <div class="alert alert-warning">
                        <h6>Warnings:</h6>
                        <ul class="mb-0 small">
                            @foreach (var warning in importResult.Warnings.Take(10))
                            {
                                <li>@warning</li>
                            }
                            @if (importResult.Warnings.Count > 10)
                            {
                                <li><em>... and @(importResult.Warnings.Count - 10) more</em></li>
                            }
                        </ul>
                    </div>
                }

                @if (importResult.Errors.Any())
                {
                    <div class="alert alert-danger">
                        <h6>Errors:</h6>
                        <ul class="mb-0 small">
                            @foreach (var error in importResult.Errors.Take(10))
                            {
                                <li>@error</li>
                            }
                            @if (importResult.Errors.Count > 10)
                            {
                                <li><em>... and @(importResult.Errors.Count - 10) more</em></li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">
                <strong>Error:</strong> @errorMessage
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0">Trips</h3>
        <button class="btn btn-sm btn-outline-primary" @onclick="LoadTrips" disabled="@isLoadingTrips">
            @if (isLoadingTrips)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            <span>Refresh</span>
        </button>
    </div>
    <div class="card-body">
        @if (isLoadingTrips)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Loading trips...</p>
            </div>
        }
        else if (trips == null || !trips.Any())
        {
            <div class="alert alert-info">
                No trips found. Upload an equipment events CSV file to create trips.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Equipment ID</th>
                            <th>Origin</th>
                            <th>Destination</th>
                            <th>Start Date/Time (UTC)</th>
                            <th>End Date/Time (UTC)</th>
                            <th>Total Trip Hours</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trip in trips)
                        {
                            <tr class="@(selectedTrip?.TripId == trip.TripId ? "table-active" : "")">
                                <td>@trip.EquipmentId</td>
                                <td>@trip.OriginCity</td>
                                <td>@trip.DestinationCity</td>
                                <td>@trip.StartUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@trip.EndUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@trip.TotalTripHours.ToString("F2")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-info" 
                                            @onclick="() => ViewTripEvents(trip)"
                                            disabled="@isLoadingEvents">
                                        @if (isLoadingEvents && selectedTrip?.TripId == trip.TripId)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            <span>View Events</span>
                                        }
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-2 text-muted">
                <small>Total Trips: @trips.Count</small>
            </div>
        }
    </div>
</div>

@* Bonus Feature: Trip Events Modal *@
@if (selectedTrip != null && tripEvents != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Trip Events - Equipment @selectedTrip.EquipmentId</h5>
                    <button type="button" class="btn-close" @onclick="CloseEventsModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Origin:</strong> @selectedTrip.OriginCity<br />
                            <strong>Start:</strong> @selectedTrip.StartUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
                        </div>
                        <div class="col-md-6">
                            <strong>Destination:</strong> @selectedTrip.DestinationCity<br />
                            <strong>End:</strong> @selectedTrip.EndUtc.ToString("yyyy-MM-dd HH:mm:ss") UTC
                        </div>
                    </div>

                    <hr />

                    <h6>Events (Chronological Order)</h6>
                    @if (tripEvents.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Event Code</th>
                                        <th>City</th>
                                        <th>Local Time</th>
                                        <th>UTC Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < tripEvents.Count; i++)
                                    {
                                        var evt = tripEvents[i];
                                        var isStartEvent = evt.EventCode == "W";
                                        var isEndEvent = evt.EventCode == "Z";
                                        var isArrived = evt.EventCode == "A";
                                        var isDeparted = evt.EventCode == "D";
                                        var rowClass = isStartEvent ? "table-success" : 
                                                      (isEndEvent ? "table-warning" : 
                                                      (isArrived ? "table-info" : 
                                                      (isDeparted ? "table-primary" : "")));

                                        <tr class="@rowClass">
                                            <td>@(i + 1)</td>
                                            <td>
                                                <strong>@evt.EventCode</strong>
                                                @if (isStartEvent)
                                                {
                                                    <span class="badge bg-success ms-1">Start</span>
                                                }
                                                else if (isEndEvent)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1">End</span>
                                                }
                                                <br />
                                                <small class="text-muted">@GetEventDescription(evt.EventCode)</small>
                                            </td>
                                            <td>@evt.CityName</td>
                                            <td>@evt.EventTimeLocal.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td>@evt.EventTimeUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="alert alert-info mt-3">
                            <small>
                                <strong>Event Code Legend:</strong><br />
                                @if (eventCodeDefinitions.Any())
                                {
                                    @foreach (var kvp in eventCodeDefinitions.OrderBy(x => x.Key))
                                    {
                                        var isW = kvp.Key == "W";
                                        var isZ = kvp.Key == "Z";
                                        var isA = kvp.Key == "A";
                                        var isD = kvp.Key == "D";
                                        var badgeClass = isW ? "bg-success" : 
                                                        (isZ ? "bg-warning text-dark" : 
                                                        (isA ? "bg-info" : 
                                                        (isD ? "bg-primary" : "bg-secondary")));
                                        
                                        <span class="badge @badgeClass ms-2">
                                            @kvp.Key = @kvp.Value.EventDescription
                                        </span>
                                        <br />
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-success ms-2">W = Released (Trip Start)</span>
                                    <span class="badge bg-info ms-2">A = Arrived</span>
                                    <span class="badge bg-primary ms-2">D = Departed</span>
                                    <span class="badge bg-warning text-dark ms-2">Z = Placed (Trip End)</span>
                                }
                            </small>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">No events found for this trip.</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEventsModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
private IBrowserFile? selectedFile;
private List<TripDto>? trips;
private TripDto? selectedTrip;
private List<EquipmentEventDto>? tripEvents;
private ImportResultDto? importResult;
private string? errorMessage;
private Dictionary<string, EventCodeDefinitionDto> eventCodeDefinitions = new();
    
private bool isUploading = false;
private bool isLoadingTrips = false;
private bool isLoadingEvents = false;

private const long MaxFileSize = 10 * 1024 * 1024; // 10MB

protected override async Task OnInitializedAsync()
{
    await LoadEventCodeDefinitionsAsync();
    await LoadTrips();
}
    
private async Task LoadEventCodeDefinitionsAsync()
{
    try
    {
        var eventCodes = await Http.GetFromJsonAsync<List<EventCodeDefinitionDto>>("api/railcar-trips/event-codes");
        if (eventCodes != null)
        {
            eventCodeDefinitions = eventCodes.ToDictionary(e => e.EventCode);
        }
    }
    catch (Exception ex)
    {
        // Log error but don't fail - event codes are nice-to-have
        Console.WriteLine($"Failed to load event code definitions: {ex.Message}");
    }
}
    
private string GetEventDescription(string eventCode)
{
    if (eventCodeDefinitions.TryGetValue(eventCode, out var definition))
    {
        return definition.EventDescription;
    }
    return eventCode;
}
    
private string GetEventLongDescription(string eventCode)
{
    if (eventCodeDefinitions.TryGetValue(eventCode, out var definition))
    {
        return definition.LongDescription;
    }
    return string.Empty;
}

    private void HandleFileSelection(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = null;
        importResult = null;

        // TODO: Add client-side validation for file type and size
        if (selectedFile != null)
        {
            if (selectedFile.Size > MaxFileSize)
            {
                errorMessage = $"File size exceeds maximum allowed size of {FormatFileSize(MaxFileSize)}.";
                selectedFile = null;
            }
            else if (!selectedFile.Name.EndsWith(".csv", StringComparison.OrdinalIgnoreCase))
            {
                errorMessage = "Only CSV files are allowed.";
                selectedFile = null;
            }
        }
    }

    private async Task ProcessFile()
    {
        if (selectedFile == null) return;

        isUploading = true;
        errorMessage = null;
        importResult = null;

        try
        {
            // Read file content
            using var stream = selectedFile.OpenReadStream(MaxFileSize);
            using var content = new MultipartFormDataContent();
            using var fileContent = new StreamContent(stream);
            
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("text/csv");
            content.Add(fileContent, "file", selectedFile.Name);

            // TODO: Configure API base URL from configuration
            var response = await Http.PostAsync("api/railcar-trips/import", content);

            if (response.IsSuccessStatusCode)
            {
                importResult = await response.Content.ReadFromJsonAsync<ImportResultDto>();
                
                if (importResult?.Success == true)
                {
                    // Refresh trips grid after successful import
                    await LoadTrips();
                    
                    // Clear file selection
                    selectedFile = null;
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Upload failed: {response.StatusCode} - {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred while processing the file: {ex.Message}";
            // TODO: Log exception details for debugging
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task LoadTrips()
    {
        isLoadingTrips = true;
        errorMessage = null;

        try
        {
            // TODO: Add pagination support for large datasets
            trips = await Http.GetFromJsonAsync<List<TripDto>>("api/railcar-trips");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load trips: {ex.Message}";
            trips = new List<TripDto>();
            // TODO: Log exception details
        }
        finally
        {
            isLoadingTrips = false;
        }
    }

    private async Task ViewTripEvents(TripDto trip)
    {
        selectedTrip = trip;
        isLoadingEvents = true;
        tripEvents = null;

        try
        {
            tripEvents = await Http.GetFromJsonAsync<List<EquipmentEventDto>>($"api/railcar-trips/{trip.TripId}/events");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load trip events: {ex.Message}";
            // TODO: Show error in modal instead of page-level error
        }
        finally
        {
            isLoadingEvents = false;
        }
    }

    private void CloseEventsModal()
    {
        selectedTrip = null;
        tripEvents = null;
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
}
